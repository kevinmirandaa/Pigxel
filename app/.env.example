# Copia este archivo a .env (nunca subas .env al repositorio).
# Solo variables EXPO_PUBLIC_*: se incluyen en el bundle de la app.
# NUNCA pongas aquí la service_role key de Supabase.

# mock = datos de ejemplo locales | supabase = backend real (Fase 6)
EXPO_PUBLIC_DATA_SOURCE=mock

# Solo necesarias cuando EXPO_PUBLIC_DATA_SOURCE=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Solo con DATA_SOURCE=mock: arranca con sesión iniciada (útil para navegar las pantallas)
EXPO_PUBLIC_MOCK_SIGNED_IN=false


# Correo al que llegan Soporte técnico, Comentarios y Reportes de error (Ajustes › Ayuda).
# Si queda vacío, la app muestra "Configura el correo de soporte".
EXPO_PUBLIC_SUPPORT_EMAIL=

# Muestra el índice de pantallas y la galería de componentes al abrir (solo desarrollo)
# EXPO_PUBLIC_SHOW_DEV_LAUNCHER=true
